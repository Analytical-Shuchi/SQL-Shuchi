            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Patient Distribution by Hospital Region</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='12162' id='7' story-point-id='1' type-v2='text' w='33305' x='837' y='30236'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10' italic='true'>The West region has the highest patient count, indicating higher demand for healthcare services.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5068' id='8' story-point-id='1' type-v2='text' w='23347' x='37741' y='23986'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Treatment Cost by Department</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='8108' id='9' story-point-id='1' type-v2='text' w='33305' x='36653' y='31419'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10' italic='true'>Neurology has the highest treatment cost, suggesting higher resource utilization</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5068' id='10' story-point-id='1' type-v2='text' w='21757' x='1339' y='45270'>

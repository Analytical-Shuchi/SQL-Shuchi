          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10' italic='true'>Patient outcomes are distributed across Recovered, Critical, and Under Treatment, helping monitor care quality.</run>
          </formatted-text>
        </zone>
